// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Home Assistant connection settings
model HAConnection {
  id           String   @id @default(cuid())
  url          String
  clientId     String   @default("http://spoolmansync") // OAuth client_id used for auth
  accessToken  String   // Service account access token (used by app)
  refreshToken String?  // Service account refresh token
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Spoolman connection settings
model SpoolmanConnection {
  id        String   @id @default(cuid())
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Application settings
model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Automation registry - tracks created HA automations
model Automation {
  id             String   @id @default(cuid())
  haAutomationId String   @unique // HA's automation ID
  trayId         String   // The tray this automation monitors
  printerId      String   // The printer entity ID
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Activity log for debugging/monitoring
model ActivityLog {
  id        String   @id @default(cuid())
  type      String   // "spool_change", "automation_created", "error", etc.
  message   String
  details   String?  // JSON string for additional data
  createdAt DateTime @default(now())
}

// Filament usage tracked by SpoolmanSync itself (see src/lib/usage): one row per print
model PrintSession {
  id         String           @id @default(cuid())
  printer    String           // printer prefix
  name       String?          // job name the printer reported
  startedAt  DateTime
  endedAt    DateTime?        // null while the print is running
  outcome    String?          // finished | failed | cancelled | ended | interrupted | abandoned
  settled    Boolean          @default(false) // every deduction for this print has been made
  attention  String?          // why the user should check this print, if anything
  state      String           // JSON, see SessionState in src/lib/usage/session.ts
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deductions UsageDeduction[]

  @@index([printer, endedAt])
  @@index([settled])
}

// One write to Spoolman's /use endpoint for a print
model UsageDeduction {
  id        String       @id @default(cuid())
  sessionId String
  session   PrintSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  trayKey   String
  spoolId   Int
  amount    Float        // in the print's unit: grams (Bambu) or cm (Creality)
  grams     Float
  status    String       // pending | done | uncertain
  createdAt DateTime     @default(now())

  @@index([sessionId])
}
